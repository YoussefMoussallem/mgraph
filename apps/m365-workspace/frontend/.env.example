# Copy to `.env` (gitignored) and fill in.
#
# The Entra ID app registration must be of type "Single-page application"
# with your dev origin (e.g. http://localhost:5173) listed as a redirect URI,
# AND expose an API scope (api://<client-id>/access_as_user): this app sends
# the backend an access token for that scope, which the backend exchanges
# on-behalf-of for Microsoft Graph. Same registration as the backend's
# AZURE_CLIENT_ID / AZURE_TENANT_ID.

# Azure AD (Entra ID) SPA sign-in
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Full scope string the backend requires. Blank = api://<VITE_AZURE_CLIENT_ID>/access_as_user
VITE_API_SCOPE=

# Backend the Vite dev server proxies /api to (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=
