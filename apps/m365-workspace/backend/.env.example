# M365 Workspace backend — environment template.
#
# Copy to `.env` and fill in real values. Production deployments
# ignore .env entirely (see app/config.py::_resolve_env_file) — every
# key here must arrive as a real env var (Docker/K8s/App Service).
#
# IMPORTANT: every key below is REQUIRED. The backend has no defaults
# in `_EnvSettings` — a missing key crashes the process at boot with
# a clear "Field required" error. To "leave a value blank" set the key
# with no value (e.g. `OPENAI_BASE_URL=`); that's different from
# omitting the line entirely.

# ── App ─────────────────────────────────────────────────────────────────
APP_NAME=M365 Workspace
# One of: development | staging | production
APP_ENVIRONMENT=development

# ── Azure AD / Entra ID (must match the frontend VITE_AZURE_* values) ───
# The app registration's appId + tenantId. This app calls Microsoft Graph
# on the caller's behalf, so the registration must also expose an API
# scope (below), hold a client credential, and have the delegated Graph
# permissions admin-consented — see the app README for the exact list.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# ── API scope ───────────────────────────────────────────────────────────
# The scope name exposed on the registration (api://<AZURE_CLIENT_ID>/<scope>).
# The backend requires an ACCESS token carrying it — the only kind Entra
# will exchange on-behalf-of for a Graph token. Blank turns Graph off and
# the backend falls back to validating ID tokens (auth-only routes work,
# every Outlook/SharePoint/agent route fails with a wiring error).
API_REQUIRED_SCOPE=access_as_user

# ── Client credential ───────────────────────────────────────────────────
# The on-behalf-of exchange is a confidential-client operation, so the app
# authenticates itself too. Exactly one of these; certificate is the
# production posture.
AZURE_CLIENT_SECRET=
AZURE_CERTIFICATE_PATH=

# ── Assistant (LLM) ─────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI itself (leave OPENAI_BASE_URL
# blank), Azure OpenAI through a proxy, LiteLLM, ... The assistant tab is
# disabled until both OPENAI_API_KEY and AGENT_MODEL are set; everything
# else in the app works without them.
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=gpt-4o-mini

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated. In dev the Vite proxy makes the SPA same-origin, so
# this mostly matters when something calls the API cross-origin directly.
CORS_ALLOW_ORIGINS=http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── TLS / corporate CA (optional; never commit PEM bundles into git) ────
# JWKS fetching and the Graph client read the process environment —
# export ONE of these in your shell / IDE / container before starting
# uvicorn (a line in .env alone is not enough):
#   SSL_CERT_FILE
#   REQUESTS_CA_BUNDLE
