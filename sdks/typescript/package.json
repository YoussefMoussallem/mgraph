{
  "name": "genai-sdk-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @genai-sdk/langfuse-client run build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "mkdocs build --strict"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  }
}
