# Copy to `.env` (gitignored) and fill in.
#
# The Entra ID app registration must be of type "Single-page application"
# with your dev origin (e.g. http://localhost:5173) listed as a redirect URI.

# Azure AD (Entra ID) SPA sign-in
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Backend the Vite dev server proxies /api to (default: http://127.0.0.1:8000)
VITE_API_PROXY_TARGET=
