# Backend scaffold — environment template.
#
# Copy to `.env` and fill in real values. Production deployments
# ignore .env entirely (see app/config.py::_resolve_env_file) — every
# key here must arrive as a real env var (Docker/K8s/App Service).
#
# IMPORTANT: every key below is REQUIRED. The backend has no defaults
# in `_EnvSettings` — a missing key crashes the process at boot with
# a clear "Field required" error. This is deliberate: it makes config
# drift and env-key typos visible immediately. To "leave a value blank"
# set the key with no value (e.g. `AZURE_CLIENT_ID=`); that's
# different from omitting the line entirely.

# ── App ─────────────────────────────────────────────────────────────────
APP_NAME=My App Backend
# One of: development | staging | production
APP_ENVIRONMENT=development

# ── Azure AD / Entra ID (must match the frontend VITE_AZURE_* values) ───
# The SPA app registration's appId + tenantId. Leaving them blank in dev
# makes get_current_user return an anonymous user (no Azure setup
# needed); production refuses to boot without them.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# ── API scope (only if this app calls Microsoft Graph) ──────────────────
# Blank: the backend validates the Entra ID token MSAL hands the SPA at
# sign-in, which is all an app needs to know who is calling.
# Set (e.g. access_as_user): the backend requires an ACCESS token for its
# own exposed API scope (api://<AZURE_CLIENT_ID>/<scope>) -- the only kind
# Entra will exchange on-behalf-of for a Graph token. See app/graph.py.
API_REQUIRED_SCOPE=

# ── Client credential (only if this app calls Microsoft Graph) ──────────
# The on-behalf-of exchange is a confidential-client operation, so the app
# authenticates itself too. Exactly one of these when API_REQUIRED_SCOPE
# is set; certificate is the production posture. Blank otherwise.
AZURE_CLIENT_SECRET=
AZURE_CERTIFICATE_PATH=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all. In dev the Vite
# proxy makes the SPA same-origin, so this mostly matters when something
# calls the API cross-origin directly.
# Comma-separated. Use concrete origins when the SPA calls the API
# cross-origin with credentials (browsers reject "*" + credentials).
# Vite default: http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── TLS / corporate CA (optional; never commit PEM bundles into git) ────
# JWKS fetching for Azure AD uses ssl.create_default_context, which reads
# os.environ — export ONE of these in your shell / IDE / container before
# starting uvicorn (a line in .env alone is not enough unless your runner
# injects it into the process environment):
#   SSL_CERT_FILE
#   REQUESTS_CA_BUNDLE
